{
  "name": "atlas-image-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare-ort": "mkdir -p public/ort && cp node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.jsep.* public/ort/",
    "dev": "npm run prepare-ort && vite --host",
    "build": "npm run prepare-ort && vite build",
    "preview": "vite preview --host",
    "test": "vitest run"
  },
  "dependencies": { "@xenova/transformers": "2.17.2", "onnxruntime-web": "1.20.1" },
  "devDependencies": { "vite": "5.4.11", "vitest": "2.1.8" }
}
